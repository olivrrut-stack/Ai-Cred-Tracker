{
  "manifest_version": 3,
  "name": "AI Credit Tracker",
  "version": "1.0.0",
  "description": "Track your AI usage across Claude, ChatGPT, and Gemini in one always-visible widget.",

  "permissions": ["storage", "scripting"],

  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "storage.js",
        "scrapers/claude.js",
        "scrapers/chatgpt.js",
        "scrapers/gemini.js",
        "content/widget.js",
        "content/content.js"
      ],
      "css": ["content/widget.css"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Credit Tracker"
  }
}
